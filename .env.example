# Required organiser credentials. Replace both before starting the service.
ADMIN_USER=summit-admin
ADMIN_PASSWORD=replace-with-a-unique-random-secret-at-least-32-characters

# Production profile only: DNS for this hostname must point to this server.
PUBLIC_HOSTNAME=registrations.example.org
# Set to 1 only when the app is reached through the bundled Caddy reverse proxy.
TRUST_PROXY=0
